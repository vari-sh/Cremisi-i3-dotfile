[global]
    ### General settings ###
    follow = mouse

    # FIX HEIGHT: (min, max)
    width = 300
    height = (0, 100)

    origin = top-right

    # FIX OFFSET: (horizontal, vertical)
    offset = (10, 50)

    ### Borders and font ###
    frame_width = 2
    font = JetBrainsMono Nerd Font 10
    corner_radius = 10

    ### Cremisi Obsidian colors ###
    background = "#17171c"
    foreground = "#e9e1d1"
    frame_color = "#c42740"
    separator_color = "frame"
    highlight = "#e2586a"

[urgency_low]
    background = "#17171c"
    foreground = "#e9e1d1"
    frame_color = "#4a4a50"
    timeout = 5

[urgency_normal]
    background = "#17171c"
    foreground = "#e9e1d1"
    frame_color = "#c42740"
    timeout = 10

[urgency_critical]
    background = "#17171c"
    foreground = "#e9e1d1"
    frame_color = "#cf9142"
    timeout = 0
